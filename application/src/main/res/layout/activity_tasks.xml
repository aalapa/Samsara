<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".TasksActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_raised"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Keep toolbar for back nav + menu support -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_raised"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/ink"
            app:titleTextColor="@color/ink"
            app:subtitleTextColor="@color/ink_muted" />

        <!-- 1dp hairline rule -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

    </LinearLayout>

    <!-- Collapsible Heatmap — inset section card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heatmapCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_sunken"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header row: section title + chevron -->
            <LinearLayout
                android:id="@+id/heatmapHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/heatmapTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/heatmap_activity"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:textAllCaps="false" />

                <ImageView
                    android:id="@+id/heatmapArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:rotation="0"
                    android:src="@drawable/ic_expand_more"
                    android:tint="@color/ink_muted"
                    android:contentDescription="Toggle heatmap" />

            </LinearLayout>

            <!-- Heatmap content (collapsible, starts closed) -->
            <LinearLayout
                android:id="@+id/heatmapContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingHorizontal="10dp"
                android:paddingBottom="10dp">

                <com.samsara.polymath.view.HeatmapView
                    android:id="@+id/personaHeatmapView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tasksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heatmapCard" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addTaskFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="44dp"
        android:src="@drawable/ic_fab_add"
        app:backgroundTint="@color/ink"
        app:tint="@color/surface"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FAB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
