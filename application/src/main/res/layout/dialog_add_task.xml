<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/task_title_hint"
        app:hintTextColor="@color/ink_muted"
        app:boxStrokeColor="@color/ink"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/taskTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/task_description_hint"
        app:hintTextColor="@color/ink_muted"
        app:boxStrokeColor="@color/ink"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/taskDescriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/recurringCheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/recurring_task"
        android:textColor="@color/ink"
        app:buttonTint="@color/ink" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/avoidCheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/avoid_task"
        android:textColor="@color/ink"
        app:buttonTint="@color/negative" />

    <TextView
        android:id="@+id/avoidHintTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:text="@string/avoid_task_hint"
        android:textColor="@color/ink_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Frequency picker (shown when recurring is checked) -->
    <LinearLayout
        android:id="@+id/frequencyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequency"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/frequencyRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioDaily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily"
                android:textColor="@color/ink"
                android:buttonTint="@color/ink" />

            <RadioButton
                android:id="@+id/radioWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weekly"
                android:textColor="@color/ink"
                android:buttonTint="@color/ink" />

            <RadioButton
                android:id="@+id/radioMonthly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly"
                android:textColor="@color/ink"
                android:buttonTint="@color/ink" />

            <RadioButton
                android:id="@+id/radioCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_days"
                android:textColor="@color/ink"
                android:buttonTint="@color/ink" />

        </RadioGroup>

        <!-- Month interval picker (shown for Monthly) -->
        <LinearLayout
            android:id="@+id/monthIntervalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Every"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <NumberPicker
                android:id="@+id/monthIntervalPicker"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginHorizontal="8dp"
                android:theme="@style/Theme.MaterialComponents.DayNight" />

            <TextView
                android:id="@+id/monthIntervalSuffix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="month(s)"
                android:textColor="@color/ink"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Info label for weekly/monthly -->
        <TextView
            android:id="@+id/frequencyInfoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Day-of-week chips for Custom frequency -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dayChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleLine="false"
            android:visibility="gone" />

    </LinearLayout>

    <!-- End Date picker -->
    <LinearLayout
        android:id="@+id/endDateContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/end_date"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/endDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_end_date"
            android:textColor="@color/ink_muted"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/clearEndDateButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/ink_muted"
            android:visibility="gone"
            android:contentDescription="@string/clear_end_date" />

    </LinearLayout>

</LinearLayout>
