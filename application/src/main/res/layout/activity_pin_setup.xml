<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Wordmark -->
    <TextView
        android:id="@+id/appNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="-0.035"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/setup_pin"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appNameTextView" />

    <!-- Sub-instruction -->
    <TextView
        android:id="@+id/instructionTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="40dp"
        android:text="@string/pin_setup_instruction"
        android:textAlignment="center"
        android:textColor="@color/ink_muted"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTextView" />

    <!-- PIN dots -->
    <LinearLayout
        android:id="@+id/pinDotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/instructionTextView">

        <View android:id="@+id/pinDot1" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/pinDot2" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/pinDot3" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/pinDot4" android:layout_width="12dp" android:layout_height="12dp"
            android:layout_marginHorizontal="8dp" android:background="@drawable/pin_dot_empty" />

    </LinearLayout>

    <!-- Error text -->
    <TextView
        android:id="@+id/errorTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text=""
        android:textColor="@color/negative"
        android:textSize="11.5sp"
        android:fontFamily="monospace"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pinDotsLayout" />

    <!-- Keypad -->
    <GridLayout
        android:id="@+id/pinPadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:columnCount="3"
        android:rowCount="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorTextView">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="1" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="2" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="3" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="4" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="5" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="6" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="7" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="8" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="9" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <View android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="0" android:textColor="@color/ink" android:textSize="24sp"
            android:fontFamily="monospace" android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackspace" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp" android:layout_height="72dp" android:layout_margin="4dp"
            android:text="⌫" android:textColor="@color/ink" android:textSize="22sp"
            android:fontFamily="monospace" android:textStyle="normal" />

    </GridLayout>

    <!-- Skip button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/skip_for_now"
        android:textColor="@color/ink_muted"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
