<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@color/surface_sunken"
    android:backgroundTintMode="src_atop">

    <!-- surface_sunken fill, 14dp radius applied via card wrapper in the adapter -->
    <TextView
        android:id="@+id/commentTextTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/ink"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/commentDateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11.5sp"
        android:textColor="@color/ink_muted"
        android:fontFamily="monospace" />

</LinearLayout>
