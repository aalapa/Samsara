<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".PersonaReportActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_raised"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_raised"
            app:titleTextColor="@color/ink"
            app:navigationIconTint="@color/ink"
            app:title="@string/report_title"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <!-- Text-only tabs: ink_muted unselected, ink selected, 2dp ink indicator -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/ink"
            app:tabSelectedTextColor="@color/ink"
            app:tabTextColor="@color/ink_muted"
            app:tabIndicatorHeight="2dp"
            android:background="@color/surface_raised" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hairline" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Period selector: restyled segmented control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:padding="3dp"
            android:background="@drawable/segmented_track_bg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weeklyButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/weekly"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                app:rippleColor="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/monthlyButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/monthly"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                android:textStyle="bold"
                app:rippleColor="@android:color/transparent" />

        </LinearLayout>

        <TextView
            android:id="@+id/dateRangeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:textAlignment="center"
            android:textSize="11.5sp"
            android:fontFamily="monospace"
            android:textColor="@color/ink_muted"
            tools:text="Jan 17 – Jan 24, 2026" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
