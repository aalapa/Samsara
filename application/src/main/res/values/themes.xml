<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Samsara" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionMenuTextColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="popupTheme">@style/PopupMenuTheme</item>
    </style>

    <style name="ThemeOverlay.AppCompat.Dark.ActionBar" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="colorControlNormal">@color/ink</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textColor">@color/ink</item>
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
    </style>

    <style name="PopupMenuTheme" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/ink</item>
    </style>

    <style name="ShapeAppearance.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>
